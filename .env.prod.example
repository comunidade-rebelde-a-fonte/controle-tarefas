# Modelo do .env.prod (copie para .env.prod, que NÃO é versionado, e troque os valores).
# Senhas: use valores longos e só com caracteres seguros para URL, por exemplo:
#   openssl rand -hex 24

POSTGRES_USER=controle
POSTGRES_PASSWORD=
POSTGRES_DB=controle

# Porta e interface publicadas no host. Por padrão só em 127.0.0.1 (use um proxy reverso
# com HTTPS na frente); 0.0.0.0 expõe na rede local.
APP_BIND=127.0.0.1
APP_PORT=8080

# Versão da imagem construída (tag do git, por exemplo v1.0.0).
APP_VERSION=local

APP_TIMEZONE=America/Sao_Paulo
# Origem pública da interface, se for diferente da própria API (normalmente vazio: mesma origem).
CORS_ORIGINS=
LOG_LEVEL=info

# Backup (scripts/backup.sh): dias de retenção dos backups locais.
BACKUP_RETENTION_DAYS=14
