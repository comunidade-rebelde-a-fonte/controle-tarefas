# Modelo do .env.prod (copie para .env.prod, que NÃO é versionado, e preencha os valores).
# Usado pelo docker-compose.prod.yml e pelos scripts/backup.sh e restore.sh (docs/operacao.md).
#
# Segredos: os campos vazios abaixo são obrigatórios; o compose recusa subir sem eles. Use valores
# longos e só com caracteres seguros para URL, por exemplo:
#   openssl rand -hex 24
# Nunca reaproveite os valores "dev-only" do .env de desenvolvimento.

# --- Banco da aplicação ---
POSTGRES_USER=controle
POSTGRES_PASSWORD=
POSTGRES_DB=controle

# --- Aplicação (API + interface) ---
# Porta e interface publicadas no host. Por padrão só em 127.0.0.1 (use um proxy reverso com HTTPS
# na frente); 0.0.0.0 expõe na rede local.
APP_BIND=127.0.0.1
APP_PORT=8080
# Versão da imagem construída (tag do git, por exemplo v1.0.0). O worker usa a mesma imagem.
APP_VERSION=local
APP_TIMEZONE=America/Sao_Paulo
# Origem pública da interface, se for diferente da própria API (normalmente vazio: mesma origem).
CORS_ORIGINS=
LOG_LEVEL=info
DB_MAX_CONNS=10

# --- Worker (jobs assíncronos: PGDAS-D, Conciliação, agentes e envio ao Langfuse) ---
WORKER_ID=worker-1
WORKER_DB_MAX_CONNS=5
# Jobs simultâneos, tentativas por job, espera com a fila vazia (s) e prazo da posse de um job (s).
WORKER_CONCURRENCY=1
JOB_MAX_TENTATIVAS=3
JOB_POLL_SECONDS=1
JOB_LEASE_SECONDS=300
# Fila semanal do priorizador do Fator R: aos domingos, a partir desta hora (0 a 23).
ROTINA_PRIORIZADOR_HORA=7

# --- MinIO: originais da Conciliação (bucket versionado, sem porta no host) ---
# S3_ROOT_*: administrador do MinIO, usado só pelo minio-init e pelo backup. S3_ACCESS_KEY e
# S3_SECRET_KEY: usuário da aplicação, sem permissão de apagar (docker/minio/init.sh).
S3_ROOT_USER=minio-admin
S3_ROOT_PASSWORD=
S3_ACCESS_KEY=conciliacao-app
S3_SECRET_KEY=
S3_BUCKET=conciliacao-originais
# Limiares e agentes automáticos da Conciliação (padrões da origem; ver .env.example).
LIMIAR_TRIAGEM=0.70
LIMIAR_CAMPO=0.70
LIMIAR_FUZZY=0.86
RESOLVEDOR_AUTOMATICO=false
CLASSIFICADOR_AUTOMATICO=false
META_CONCILIACAO_AUTO=80

# --- LiteLLM: gateway de modelos dos agentes (sem porta no host) ---
LITELLM_MASTER_KEY=
LITELLM_TIMEOUT_SECONDS=120
# Chaves dos provedores: só aqui (o compose as entrega apenas ao container do LiteLLM). Sem chave,
# os agentes que usam modelo ficam indisponíveis; o resto do sistema funciona.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo padrão de cada alias (provedor/modelo), trocável também na tela Configurações → IA.
TRIADOR_MODEL=openai/gpt-6-luna
EXTRATOR_MODEL=openai/gpt-6-sol
EXTRATOR_FORTE_MODEL=openai/gpt-6-astra
RESOLVEDOR_MODEL=openai/gpt-6-sol
CLASSIFICADOR_MODEL=openai/gpt-6-sol
CONSULTOR_MODEL=openai/gpt-6-luna
PRIORIZADOR_MODEL=openai/gpt-6-luna

# --- n8n: ingestão automatizada (interface em 127.0.0.1) ---
N8N_PORT=5678
# Pasta do host monitorada pelo workflow de ingestão (documentos de clientes: fora do git).
N8N_INBOX_DIR=./n8n/inbox

# --- Langfuse: observabilidade dos agentes (interface em 127.0.0.1) ---
LANGFUSE_WEB_PORT=3100
# Endereço do Langfuse no navegador; também monta os links do trace na tela de auditoria.
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=
SALT=
# 64 caracteres hexadecimais: openssl rand -hex 32
ENCRYPTION_KEY=
LF_POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
# Senha do MinIO interno do Langfuse (eventos e mídia), diferente do MinIO da Conciliação.
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
# Projeto criado na inicialização; o worker envia os traces com estas chaves. Formato:
#   LANGFUSE_PUBLIC_KEY=pk-lf-<openssl rand -hex 16>
#   LANGFUSE_SECRET_KEY=sk-lf-<openssl rand -hex 24>
LANGFUSE_PROJECT_ID=controle-integrado
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Usuário admin da interface do Langfuse (o cadastro aberto fica desligado).
LANGFUSE_ADMIN_EMAIL=admin@controle.local
LANGFUSE_ADMIN_PASSWORD=
LANGFUSE_ENVIRONMENT=production
# Reenvio das corridas com falha (s) e limite de cada atributo enviado (KB).
LANGFUSE_RETRY_SECONDS=300
TRACE_PAYLOAD_MAX_KB=32

# --- Backup (scripts/backup.sh): quantos backups manter em cada rotação (a da origem) ---
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
