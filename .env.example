# Copie para .env (cp .env.example .env). O .env nunca é versionado.
# Valores apenas para desenvolvimento local.

# --- Banco local (docker compose) ---
POSTGRES_USER=controle
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=controle
# Porta publicada no host. Se a 5432 estiver ocupada por outro Postgres, use outra (ex.: 5433)
# e ajuste também a porta do DATABASE_URL abaixo.
POSTGRES_PORT=5432

# --- API ---
# DATABASE_URL para uso no HOST (make migrate, go run, testes manuais).
# Dentro do docker compose o host é "db" (a URL do container é montada no docker-compose.yml).
DATABASE_URL=postgres://controle:dev-only-change-me@localhost:5432/controle?sslmode=disable
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
HTTP_PORT=8080
# Origens permitidas no CORS, separadas por vírgula. Nunca usar "*".
CORS_ORIGINS=http://localhost:5173
# Diretório dos arquivos de procurações/certificados (fora do webroot).
FILE_STORAGE_DIR=./storage
DB_MAX_CONNS=10

# --- Windows (Docker Desktop) ---
# Descomente para o testcontainers (make test) usar o pipe do Docker diretamente. Sem isso, com
# muitos pacotes subindo Postgres em paralelo, a detecção pode falhar ("rootless Docker is not
# supported on Windows"). Ver README, seção Testes.
# DOCKER_HOST=npipe:////./pipe/docker_engine
